---
import { getLang, useUI } from '../i18n';
const ui = useUI(getLang(Astro.currentLocale));
---
<!-- the accessible name starts with the visible text (WCAG 2.5.3 label in name) -->
<button id="theme-toggle" type="button"
  class="font-mono text-xs text-muted hover:text-fg border border-line rounded px-2 py-1 transition-colors cursor-pointer">
  <span class="light:hidden">{ui.themeDark}</span>
  <span class="hidden light:inline">{ui.themeLight}</span>
  <span class="sr-only">· {ui.themeLabel}</span>
</button>
<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const light = document.documentElement.classList.toggle('light');
    try { localStorage.setItem('theme', light ? 'light' : 'dark'); } catch {}
  });
</script>
