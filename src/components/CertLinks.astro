---
// Verification link (and an optional own copy) for a certification or a course.
import type { Certification } from '../data/certifications';
import { getLang, useUI } from '../i18n';
interface Props { c: Certification; class?: string }
const { c, class: cls = '' } = Astro.props;
const ui = useUI(getLang(Astro.currentLocale));
---
{(c.verifyUrl || c.file) && (
  <span class={`flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs ${cls}`}>
    {c.verifyUrl && <a class="link" href={c.verifyUrl} target="_blank" rel="noopener noreferrer">{ui.verify} ↗</a>}
    {c.file && <a class="link" href={c.file} target="_blank" rel="noopener noreferrer">{ui.viewCert} ↗</a>}
  </span>
)}
