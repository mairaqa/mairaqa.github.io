---
import SectionTitle from './SectionTitle.astro';
import HiddenBug from './HiddenBug.astro';
import { experience } from '../data/experience';
import { getLang, useUI, t } from '../i18n';
import { sentence, title, terms } from '../i18n/case';
const lang = getLang(Astro.currentLocale);
const ui = useUI(lang);
---
<section id="experience" aria-labelledby="experience-title" class="reveal mx-auto max-w-4xl px-4 sm:px-6 py-14 sm:py-16">
  <SectionTitle n="03" id="experience" label={ui.experience} meta="git log --oneline" />
  <div class="relative">
  <HiddenBug id="experience" class="left-0 -bottom-9" />
  <ol class="border-l border-line ml-1.5 space-y-12">
    {experience.map((job) => (
      <li class="pl-8 relative">
        <span class={`absolute -left-[7px] top-1.5 size-3 rounded-full border-2 border-bg ${job.current ? 'bg-pass' : 'bg-muted'}`} aria-hidden="true"></span>
        <p class="font-mono text-xs text-muted">[{t(job.period, lang)}]</p>
        <h3 class="mt-1 font-mono text-lg font-semibold">
          {title(t(job.role, lang))} <span class="text-muted font-normal">@</span> <span class="text-pass">{job.company}</span>
        </h3>
        {job.client && <p class="mt-0.5 font-mono text-xs text-muted">{ui.client}: <span class="text-fg">{terms(t(job.client, lang))}</span></p>}
        <ul class="mt-3 space-y-1.5 text-muted">
          {t(job.bullets, lang).map((b) => <li class="flex gap-2"><span class="font-mono text-pass" aria-hidden="true">+</span><span>{sentence(b)}</span></li>)}
        </ul>
        <p class="mt-3 font-mono text-xs text-muted">{job.stack.join(' · ')}</p>
      </li>
    ))}
  </ol>
  </div>
</section>
