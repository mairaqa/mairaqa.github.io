---
import Bug from './Bug.astro';
import { getLang, useUI } from '../i18n';
const ui = useUI(getLang(Astro.currentLocale));
---
<button type="button" data-hunt-toggle aria-label={ui.hunt.counter(0, 6)}
  class="hunt-counter inline-flex items-center gap-1 rounded border border-line px-2 py-1 font-mono text-xs text-muted hover:text-fg transition-colors cursor-pointer">
  <Bug class="size-3.5 text-fail" /><span data-hunt-count>0/6</span>
</button>
